{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",

      "Bash(cat **/.env*)",
      "Bash(less **/.env*)",
      "Bash(more **/.env*)",
      "Bash(grep * **/.env*)",
      "Bash(vim **/.env*)",
      "Bash(nano **/.env*)"
    ]
  }
}